PORT=3001
JWT_SECRET=dev-secret-change-me

# 数据库（MySQL）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123456
DB_NAME=bid_demo
CLOUD_DB_URL=                 # 若配置云 MySQL（RDS），优先直连，跳过本地装配

STORAGE_DIR=./storage/uploads
STORAGE_DRIVER=local          # local | minio

# 云端同步（Docker 定时把 MySQL dump 上传到云端对象存储）
CLOUD_STORAGE_DRIVER=         # s3 | oss | minio，留空则不启用云端同步
CLOUD_ENDPOINT=
CLOUD_BUCKET=
CLOUD_ACCESS_KEY=
CLOUD_SECRET_KEY=

LLM_API_KEY=                   # 留空则启用 mock
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MOCK=true                  # true=强制 mock，false=有 key 时真实调用
LLM_TIMEOUT_MS=30000
